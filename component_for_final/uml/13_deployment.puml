@startuml deployment
' Deployment diagram - triển khai chạy thực tế
skinparam shadowing false
title Deployment Diagram - Triển khai hệ thống

node "Máy chủ GPU (Windows, RTX 4060 8GB)" as HOST {

  node "Process Python 3.7\n(carla_bridge/server.py)" as P37 {
    [CARLA PythonAPI 0.9.9.4]
  }

  node "CARLA Simulator\n(CarlaUE4.exe, UE4)" as CARLA

  node "Process Python 3.10\n(venv_tracking)" as P310 {
    [AI Pipeline\n(main.py / ai_processor.py)]
    [PyTorch + Ultralytics + boxmot + torchreid]
  }

  node "FastAPI + Uvicorn" as SERVER {
    [REST :8000 / WebSocket / MJPEG]
    database "SQLite\ntracking_system.db" as DB
  }

  node "Vite dev / static (frontend)" as WEB {
    [React + Leaflet :3000]
  }
}

node "Trình duyệt người vận hành" as BROWSER {
  [Dashboard + MapView]
}

cloud "OpenStreetMap tiles" as TILES

CARLA <--> P37 : RPC :2000
P37 --> P310 : frame qua TCP :8765
P310 --> SERVER : in-process (background thread)
SERVER --> DB
BROWSER --> SERVER : HTTP/WS (proxy qua :3000)
BROWSER --> WEB
BROWSER ..> TILES : tải tile bản đồ
@enduml
