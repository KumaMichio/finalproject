@startuml sequence_tracking_xuyen_camera
' Sequence diagram - Tracking xuyên camera
skinparam shadowing false
title Sequence Diagram - Theo dõi xuyên camera (hạ tầng Re-ID hỗ trợ UC1)

actor "Người vận hành" as Op
participant "VideoSource\n(camera)" as VS
participant "ObjectDetector\n(YOLO11)" as Det
participant "ByteTrackWrapper" as BT
participant "DualReIDExtractor\n(OSNet)" as ReID
participant "GlobalTracker" as GT
database "SQLite DB" as DB

Op -> VS : bật giám sát
loop mỗi khung hình (đồng bộ N camera)
  VS -> Det : detect_batch(frames)
  Det --> VS : detections[ {box, class, conf} ]
  VS -> BT : update(detections, frame)
  BT --> VS : local_tracks[ {track_id, box, class} ]
  VS -> ReID : extract_feature(frame, box, class)
  ReID --> VS : embedding[512]
  VS -> GT : process_camera_tracks(cam_id, tracks, embeddings)
  GT -> GT : cosine match + Spatio-Temporal Filter
  alt match đủ tin cậy
    GT -> GT : gán Global ID đã tồn tại
  else không match
    GT -> GT : tạo Global ID mới
  end
  GT --> VS : global_tracks[ {global_id, cam_id, box} ]
  VS -> DB : upsert tracked_objects + tracking_history
end
VS --> Op : luồng có Global ID nhất quán (dashboard)
@enduml
