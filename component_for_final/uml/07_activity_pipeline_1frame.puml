@startuml activity_pipeline_1frame
' Biểu đồ hoạt động: luồng xử lý AI cho một khung hình
skinparam shadowing false
title Biểu đồ hoạt động - Luồng xử lý AI cho một khung hình (per-frame pipeline)

start
:Lấy khung hình đồng bộ từ các camera\n(VideoSource: CARLA/RTSP/File/Webcam);
:Detection - YOLO11 detect_batch()\n(1 GPU forward cho tất cả camera);
note right: lọc theo ngưỡng tin cậy\ntừng lớp + NMS

partition "Mỗi camera" {
  :Tracking - ByteTrackWrapper.update()\n(Kalman + Hungarian + dual-threshold);
  :ReID - DualReIDExtractor.extract_feature()\n(OSNet -> embedding 512D);
}

:GlobalTracker.process_camera_tracks()\nso khớp cosine + Spatio-Temporal Filter\n-> gán Global ID;
:TrajectoryPredictor.predict()\n(Kalman + GRU ensemble, 0.5s..3.0s);

fork
  :AlertSystem.check_alerts()\n(point-in-polygon ROI);
fork again
  :IncidentDetector.update()\n(14 loại: 12 reactive + 2 proactive);
end fork

if (Đối tượng được đánh dấu\nhoặc tới ngã tư?) then (Có)
  :GoalClassifier.predict()\n-> hướng rẽ + xác suất;
  :RoutePredictor.predict()\n-> hành trình nhiều ngã tư (lat/lon);
else (Không)
endif

if (Sự cố mức CRITICAL?) then (Có)
  :EvidencePackage.capture()\n(clip 30s + crop + JSON);
else (Không)
endif

:Đẩy kết quả qua WebSocket/MJPEG\n-> Dashboard + MapView;
stop
@enduml
