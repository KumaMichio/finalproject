@startuml class_diagram
' Class diagram - các lớp chính của AI pipeline + dữ liệu
skinparam shadowing false
skinparam classAttributeIconSize 0
title Class Diagram - Hệ thống giám sát & truy vết đa camera (lõi AI pipeline)

' ---------- Nguồn video ----------
abstract class VideoSource {
  +get_frame()
  +release()
}
class CARLAVideoSource
class RTSPVideoSource
class FileVideoSource
class WebcamVideoSource
class CARLABridgeClient
VideoSource <|-- CARLAVideoSource
VideoSource <|-- RTSPVideoSource
VideoSource <|-- FileVideoSource
VideoSource <|-- WebcamVideoSource
VideoSource <|.. CARLABridgeClient

' ---------- Perception ----------
class ObjectDetector {
  -model : YOLO11
  -conf_threshold
  +detect_batch(frames) : List<Detection>
}
class ByteTrackWrapper {
  -tracker
  -camera_id
  +update(detections, frame) : List<Track>
}
class ReIDExtractor {
  +extract_feature(frame, box) : float[512]
}
class DualReIDExtractor {
  -person_model : OSNet
  -vehicle_model : OSNet
  +extract_feature(frame, box, cls) : float[512]
}
ReIDExtractor <|-- DualReIDExtractor

class GlobalTracker {
  -tracks : Map
  -camera_topology
  -match_threshold
  +process_camera_tracks(cam_id, frame, tracks) : List<GlobalTrack>
  -_is_feasible_match()
}

' ---------- Behavior ----------
class TrajectoryPredictor {
  +update_trajectory(gid, center, t)
  +predict(gid) : Map<horizon, xy>
}
class EnsembleTrajectoryPredictor
class TrajectoryGRU
TrajectoryPredictor <|-- EnsembleTrajectoryPredictor
EnsembleTrajectoryPredictor o-- TrajectoryGRU

class GoalClassifier {
  -model : GradientBoosting
  -feature_names
  +predict(history) : {dir, probs}
}
class RoutePredictor {
  -junction_graph
  +predict(x,y,heading,dir,n_hops) : List<RouteHop>
  +predict_probabilistic(...) : List<Route>
}
class GeoReference {
  +carla_to_latlon(x,y) : (lat,lon)
}
RoutePredictor o-- GeoReference

' ---------- Application ----------
class AlertSystem {
  +check_alerts(gid, cam, pred, box) : List<Alert>
}
class IncidentDetector {
  +update(tracks, cam, pred, rois) : List<Incident>
}
class EvidencePackage {
  +capture(incident, frames, tracks)
}
class CameraCalibration {
  +pixel_to_world() / world_to_pixel()
}

' ---------- Data models ----------
class Detection {
  box; class; confidence
}
class Track {
  track_id; box; positions; speeds
}
class GlobalTrack {
  global_id; camera_id; class; box
}
class RouteHop {
  hop; road_id; lat; lon; direction_used; prob
}

' ---------- Quan hệ pipeline ----------
ObjectDetector --> Detection
ByteTrackWrapper --> Track
ByteTrackWrapper ..> Detection
GlobalTracker --> GlobalTrack
GlobalTracker ..> DualReIDExtractor
RoutePredictor --> RouteHop
GoalClassifier ..> RoutePredictor

class TrackingSystem {
  -source : VideoSource
  +initialize()
  +run()
}
TrackingSystem o-- VideoSource
TrackingSystem o-- ObjectDetector
TrackingSystem o-- ByteTrackWrapper
TrackingSystem o-- GlobalTracker
TrackingSystem o-- TrajectoryPredictor
TrackingSystem o-- GoalClassifier
TrackingSystem o-- RoutePredictor
TrackingSystem o-- AlertSystem
TrackingSystem o-- IncidentDetector
TrackingSystem o-- EvidencePackage
TrackingSystem o-- CameraCalibration
@enduml
