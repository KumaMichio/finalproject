@startuml component_kien_truc_tong_the
' Component diagram - kiến trúc tổng thể
skinparam shadowing false
skinparam componentStyle rectangle
title Hình - Kiến trúc tổng thể hệ thống

actor "Người vận hành" as Op

cloud "Nguồn video" as SRC {
  [CARLA Simulator] as CARLA
  [Camera IP (RTSP) / File / Webcam] as REAL
}

node "AI Pipeline\n(custom_tracking_system)" as AI {
  [VideoSource] as VS
  [Detection (YOLO11)] as DET
  [Tracking (ByteTrack)] as TRK
  [ReID (OSNet)] as RID
  [GlobalTracker\n+ Spatio-Temporal Filter] as GTR
  [Trajectory (Kalman+GRU)] as TRAJ
  [GoalClassifier + RoutePredictor\n+ Georeference] as ROUTE
  [Incident / Alert / Evidence] as INC
}

node "Backend Server (FastAPI)" as BE {
  [REST API] as REST
  [WebSocket] as WS
  [MJPEG Stream] as MJPEG
  [AIProcessor (background thread)] as AIP
  database "SQLite" as DB
}

node "Frontend (React + Leaflet)" as FE {
  [Dashboard] as DASH
  [MapView] as MAP
}

[Map/junction_graph.json\n+ OpenStreetMap tiles] as OSM

CARLA --> VS
REAL --> VS
VS --> DET --> TRK --> RID --> GTR --> TRAJ --> ROUTE
GTR --> INC
ROUTE ..> OSM : junction graph
AI --> AIP
AIP --> DB
AIP --> WS
AI --> MJPEG
FE --> REST
FE --> WS
FE --> MJPEG
MAP ..> OSM : tile layer
Op --> FE
@enduml
