@startuml usecase_tong_quat
' Hình 2.1 - Biểu đồ use case tổng quát
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome
title Hình 2.1 - Biểu đồ use case tổng quát của hệ thống giám sát & truy vết phương tiện đa camera

actor "Người vận hành" as Operator
actor "Nguồn camera/video" as Camera
actor "Bản đồ mạng lưới\nđường thực tế" as Map

rectangle "Hệ thống giám sát & truy vết phương tiện giao thông đa camera" {
  usecase "UC1 - Phát hiện & theo dõi\ntrong từng camera" as UC1
  usecase "UC3 - Phát hiện & đánh dấu sự cố" as UC3
  usecase "UC4 - Dự đoán & hiển thị hành trình" as UC4
  usecase "UC5 - Giám sát qua dashboard\nthời gian thực" as UC5
  usecase "UC6 - Quản lý camera\nvà vùng quan sát (ROI)" as UC6
}

Camera --> UC1
Operator --> UC3
Operator --> UC5
Operator --> UC6
Operator --> UC4
Map --> UC4

UC3 ..> UC1 : <<include>>
UC4 ..> UC1 : <<include>>
@enduml
